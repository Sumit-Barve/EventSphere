PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/eventsphere
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_secure_jwt_secret_here
JWT_EXPIRES_IN=1d

# Real Email Notifications (Gmail SMTP via Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_digit_app_password
EMAIL_FROM="EventSphere" <your_email@gmail.com>
